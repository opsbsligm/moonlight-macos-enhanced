# Build artifacts
build/
# Derived data from an explicit -derivedDataPath, which a second
# architecture check or a verification run writes next to build/.
build-*/

# Byte-code left by importing the audit scripts.
__pycache__/
DerivedData/
*.app
*.dmg
*.o
*.a
*.dylib

# Xcode user data
xcuserdata/
*.xcuserstate
*.xcuserdatad
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# Swift Package Manager cache
Packages/checkouts/
Packages/artifacts/
Packages/repositories/
.swiftpm/
.build/

# Large binary frameworks (managed via download script or Git LFS)
xcframeworks/
Packages/OpenSSL.xcframework/
xcframeworks.zip

# Local symlink to OpenSSL headers (build artifact, not source)
libs/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
.fseventsd
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Logs
*.log
crash_log
Logs/
DerivedData/

# Temporary
*.tmp
*.swp
*~
*.bak
*.orig

# Secrets / signing materials — never commit
.env*
*.p12
*.cer
*.crt
*.pfx
*.mobileprovision
*.provisionprofile
*.keystore
*.jks
certs/
secrets/
credentials/
**/ApiKeys*.plist
*.key
*.pem
id_rsa*
id_dsa*
*.pub

# Xcode project noise
*.xcscmblueprint
xccheckout/

# CI / local dev convenience files
.vscode/
.idea/
*.iml



# Locally assembled delivery bundles, named after the build number they carry.
dist/
# The sidecar copies verify-release-images.sh consumes when it is run locally.
checksums/

# Release body the release job assembles from .github/release-notes/.
release_body.md
