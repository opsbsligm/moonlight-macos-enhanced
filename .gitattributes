# Normalize line endings: Git stores text as LF, checks out as-is on macOS/Linux
* text=auto eol=lf

# Windows-specific files keep CRLF
*.dsp text eol=crlf
*.dsw text eol=crlf
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.icns binary
*.gif binary
*.ico binary
*.pdf binary
*.sketch binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary
*.mp3 binary
*.wav binary
*.caf binary
*.a binary
*.dylib binary
*.so binary
*.dll binary
*.o binary
*.framework binary
*.xcframework binary
*.dmg binary
*.zip binary
*.gz binary
*.xz binary

# Git LFS tracking (optional, uncomment if you need to push large binaries)
# *.dmg filter=lfs diff=lfs merge=lfs -text
# *.framework filter=lfs diff=lfs merge=lfs -text
# *.xcframework filter=lfs diff=lfs merge=lfs -text

# Export-ignore: don't include in GitHub release archives
.gitattributes export-ignore
.gitignore export-ignore
.gitlab-ci.yml export-ignore
.github export-ignore
Artwork export-ignore
scripts/export-ignore
